<h1>Authors</h1>

<p>
  <%= link_to "New Author", new_author_path %>
</p>

<table border="1" cellpadding="8">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th colspan="4">Actions</th>
    </tr>
  </thead>

  <tbody>

  <% @authors.each do |author| %>

    <tr>

      <td><%= author.name %></td>

      <td><%= author.email %></td>

      <td><%= link_to "Show", author_path(author) %></td>

      <td><%= link_to "Edit", edit_author_path(author) %></td>

      <td><%= link_to "Books", author_books_path(author) %></td>

      <td>
        <%= button_to "Delete",
              author_path(author),
              method: :delete,
              data: { turbo_confirm: "Are you sure?" } %>
      </td>

    </tr>

  <% end %>

  </tbody>
</table>