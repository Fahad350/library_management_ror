<%= form_with(model: [@author, @book]) do |form| %>

  <% if @book.errors.any? %>

    <div>

      <h3><%= pluralize(@book.errors.count, "error") %> prevented saving.</h3>

      <ul>

        <% @book.errors.full_messages.each do |message| %>

          <li><%= message %></li>

        <% end %>

      </ul>

    </div>

  <% end %>

  <p>

    <%= form.label :title %><br>

    <%= form.text_field :title %>

  </p>

  <p>

    <%= form.label :price %><br>

    <%= form.number_field :price, step: 0.01 %>

  </p>

  <%= form.submit %>

<% end %>